# === Plombir Git .dockerignore ===
# Exclude everything that shouldn't be in Docker build context.

# Rust build artifacts (huge)
target/
target/**/*

# AI assistant worktrees, target-dir seeds and notes. Gitignored, local-only,
# and the worktrees are whole copies of the repository: leaving this out made
# every `docker build` upload them (tens of gigabytes of target dirs) and, worse,
# put every sibling branch's working tree in front of the Dockerfile's COPYs.
.ai/

# Node.js dependencies and build cache
web/node_modules/
web/.svelte-kit/

# Git repositories and test data
test-repos/
testdata/

# Database files
*.db
*.db-shm
*.db-wal

# Logs
*.log

# Secrets and host-local deployment files.
#
# The build context is shipped to the daemon and anything the Dockerfile
# COPYs becomes an image layer, so a stray .env is one `COPY . .` away from
# being published; the Dockerfile's COPY list names Cargo.toml, Cargo.lock,
# rust-toolchain.toml, crates/ and web/, and none of these patterns touches
# one of those. Non-slash patterns match only the context root in Docker, so
# each is paired with a `**/` form: a secret one directory down is still in
# the context.
.env
.env.*
**/.env
**/.env.*
plombir-git*.toml
**/plombir-git*.toml
*.pem
**/*.pem
*_host_key*
**/*_host_key*
encryption_key
**/encryption_key

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Git (we fetch the current git info separately)
.git/

# Cargo incremental compilation
.cargo/registry/
.cargo/git/

# Docker
Dockerfile
.dockerignore

# Docs & misc (not needed for build)
docs/
*.md
plan.md
deploy/
scripts/

# Keep Cargo.lock and Cargo.toml
!Cargo.lock
!Cargo.toml
