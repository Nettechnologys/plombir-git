# Copy to deploy/.env before starting docker compose.
#
# Generate a strong secret, for example:
#   openssl rand -hex 32
#
# Leave this empty only if you want startup validation to fail loudly.
FORGEKEEP_JWT_SECRET=

# Optional comma-separated browser origins for cross-origin frontend/API
# deployments. These origins are also added to CSP connect-src with matching
# ws:// or wss:// origins for WebSocket endpoints.
# FORGEKEEP_CORS_ORIGINS=https://app.example.com

# Optional additional CSP connect-src values when API/WebSocket origins are not
# covered by FORGEKEEP_CORS_ORIGINS.
# FORGEKEEP_CSP_CONNECT_SRC=https://api.example.com,wss://api.example.com

# ── Container user (docker-compose.hostdir.yml only) ────────────────────────
# The image runs as a non-root user whose uid/gid are baked in at build time.
# With a bind-mounted data directory only the *number* matters — the container's
# `forgekeep` user is unrelated to a host user of the same name. Set these to
# your host owner of ./data and no chown is ever needed:
#   echo "FORGEKEEP_UID=$(id -u)" >> .env
#   echo "FORGEKEEP_GID=$(id -g)" >> .env
# Unset means 1000:1000, in which case run `sudo chown -R 1000:1000 ./data`.
# FORGEKEEP_UID=1000
# FORGEKEEP_GID=1000

# Host ports published by docker-compose.hostdir.yml. Change them when 8080 or
# 2222 is already taken on the machine; the container-side ports never change.
# FORGEKEEP_HTTP_PORT=8080
# FORGEKEEP_SSH_PORT=2222

# Optional CI runner credentials (the commented `runner` service).
# FORGEKEEP_RUNNER_ID=1
# FORGEKEEP_RUNNER_TOKEN=

# Optional observability credentials.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
