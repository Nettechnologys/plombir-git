# Copy to deploy/.env before starting docker compose.
#
# Generate a strong secret, for example:
#   openssl rand -hex 32
#
# Leave this empty only if you want startup validation to fail loudly.
PLOMBIR_GIT_JWT_SECRET=

# Key for data at rest: TOTP secrets, CI secrets, mirror and LDAP passwords,
# SSO client secrets, OAuth tokens.
#
# Leave it empty on a fresh install: the server generates a random key into
# /data/encryption_key (mode 0600) on first start and keeps using it, so
# rotating PLOMBIR_GIT_JWT_SECRET never touches the encrypted data.
#
# Set it only for an external key source (KMS, vault), and NEVER to the value of
# PLOMBIR_GIT_JWT_SECRET: one value in both makes a leaked signing secret a
# leaked encryption key. A fresh install with the two equal refuses to start.
# Plombir Git also refuses to start with a key that cannot decrypt the existing
# data, so a mistake here stops the deploy instead of breaking logins later.
PLOMBIR_GIT_ENCRYPTION_KEY=

# Who may create an account. `closed` (also the built-in default) refuses
# self-registration — except the very first account on an empty instance, which
# becomes its administrator and needs the one-time setup token the container
# prints at its first start (`docker compose logs plombir-git`, also kept 0600
# at /data/setup_token). Or skip the token and create it on the host:
#   docker compose exec plombir-git plombir-git create-admin \
#     --config /app/plombir-git.toml --username <name> --email <address>
# Switch to `open` only if strangers should be able to sign up.
PLOMBIR_GIT_REGISTRATION=closed

# Optional comma-separated browser origins for cross-origin frontend/API
# deployments. These origins are also added to CSP connect-src with matching
# ws:// or wss:// origins for WebSocket endpoints.
# PLOMBIR_GIT_CORS_ORIGINS=https://app.example.com

# Optional additional CSP connect-src values when API/WebSocket origins are not
# covered by PLOMBIR_GIT_CORS_ORIGINS.
# PLOMBIR_GIT_CSP_CONNECT_SRC=https://api.example.com,wss://api.example.com

# ── Container user (docker-compose.hostdir.yml only) ────────────────────────
# The image runs as a non-root user whose uid/gid are baked in at build time.
# With a bind-mounted data directory only the *number* matters — the container's
# `plombir-git` user is unrelated to a host user of the same name. Set these to
# your host owner of ./data and no chown is ever needed:
#   echo "PLOMBIR_GIT_UID=$(id -u)" >> .env
#   echo "PLOMBIR_GIT_GID=$(id -g)" >> .env
# Unset means 1000:1000, in which case run `sudo chown -R 1000:1000 ./data`.
# PLOMBIR_GIT_UID=1000
# PLOMBIR_GIT_GID=1000

# ── Source code link (build argument) ───────────────────────────────────────
# The commit the image is built from. It is baked into the binary, and every
# page links `<[server].source_url>/tree/<commit>` — the source offer AGPL §13
# asks of anyone serving modified code. Pass it from the shell at build time
# rather than writing it here, where it would go stale with the next pull:
#   PLOMBIR_GIT_SOURCE_COMMIT=$(git rev-parse HEAD) docker compose -f docker-compose.hostdir.yml up -d --build
# Unset, the UI links the repository without naming a commit, and the server
# warns about it at startup.
# PLOMBIR_GIT_SOURCE_COMMIT=

# Host ports published by docker-compose.hostdir.yml. Change them when 8080 or
# 2222 is already taken on the machine; the container-side ports never change.
# PLOMBIR_GIT_HTTP_PORT=8080
# PLOMBIR_GIT_SSH_PORT=2222

# Optional CI runner credentials (the commented `runner` service).
# PLOMBIR_GIT_RUNNER_ID=1
# PLOMBIR_GIT_RUNNER_TOKEN=

# Observability (docker-compose.observability.yml). The Grafana admin password
# is required: the stack refuses to start without one, rather than coming up as
# admin/admin. Generate one, for example:
#   openssl rand -hex 16
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
