#!/usr/bin/env sh
# Keep direct pushes from making `main` red after the fact without charging the
# normal card workflow for the same gates twice.
#
# `scripts/verify-push-gates.sh` runs formatting, strict workspace Clippy, and
# the cargo-free regression gates after a card commit, then records a receipt
# bound to that exact SHA. The hook accepts that receipt instead of repeating the
# work. A manual push without a receipt falls back to the verifier, so moving the
# commands into the card prompt does not weaken direct-push protection.
#
# The coverage contract proves both links in that chain: this hook must invoke
# the verifier, and the verifier must still invoke every mirrored command.
# Bypass remains Git's explicit `git push --no-verify`.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

head_sha=$(git rev-parse HEAD)
receipt_path=$(git rev-parse --git-path plombir-git-push-gates.receipt)
receipt_sha=''
if [ -r "$receipt_path" ]; then
    IFS= read -r receipt_sha < "$receipt_path" || receipt_sha=''
fi

if [ "$receipt_sha" = "$head_sha" ]; then
    printf '%s\n' "pre-push: push gates already green for $head_sha"
else
    printf '%s\n' "pre-push: no green receipt for $head_sha; running push gates"
    sh scripts/verify-push-gates.sh
fi
